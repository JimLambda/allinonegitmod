;SDL
actor

(include "vehicle.ext")
(include "armor.ext")
(include "cannon_crew.ext")
(include "cannon_armor.ext")
(include "abm.inc")
(include "mobility.inc")
(include "selection/vehicle.inc" scale(0.7))

("brain_vehicle")

{PatherID "cannon.small"}
{collider "cannon"}

{targetclass "howitzer"}
{targetSelector "cannon_aa"}

{props "with_gun" "cannon"}
{able "emit_crew_on_injure" "talk" "-emit_passangers_on_enemy"}
{lodclass "cannon"}

{sensor
	{visor "main"
		{vision "searchlight"}
		{bone "foresight3"}
	}
}

{extender "inventory"
	{box
		{Size 9 8}
		{weight 10000}
		{item "repair_kit" 3}
	}
}

{Weaponry
	{place "gun"
		{gunner "gunner"}
	}
}

{extender "talk"
	{talker "cannon"}
}

(define "restore_ik_time"
	{RestoreIKTime 10}
)

("body" repair(45))
("gun" repair(30) thickness(10))

{perks
	{blastwave_modifier 20.0}
}