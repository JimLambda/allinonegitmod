;SDL
actor

(include "vehicle.ext")
(include "car_crew.ext")
(include "armor.ext")
(include "abm.inc")
(include "mobility.inc")

("brain_vehicle")

{collider "moto"}
{props "bicycle" "wheeled" "vision_lev01" "turn_over" "vision_lev01" "explosion_throw_crew" "no_exp_blast"}
{targetClass "car"}
{targetSelector "car_bullet"}
{PatherId "bicycle"}

{able "talk"}
{able "emit_on_attack"}

{extender "inventory"
	{box
		{Size 6 2}
		{Weight 100}
		{clear}
	}
}

{sensor
	{visor "none"
		{vision "none"}
	}
}

("crew" place(driver) bone(driver) visor(none) door(emit1) animation(driver) group(crew) off())

{boarder
	{anm "driver"
		{forward	{begin "board_moto_driver"} {end "seat_bicycle_driver"} {base "up"}}
		{reverse	{end "board_moto_driver" -1}}
	}
}

(define "restore_ik_time"
	{RestoreIKTime 10}
)

{mass 70} ; 65kg human + 5kg bike
{Chassis "wheel"
	;("car_trace" fx("tracewheel03a") step(0.08) wheell("wlf") wheelr("wrf") bonel("FXtraceL1") boner("FXtraceR1"))
	;("car_trace" fx("tracewheel03a") step(0.08) wheell("wlr") wheelr("wrr") bonel("FXtraceL2") boner("FXtraceR2"))
	("mobility_car"
		speed(40) ;----------------------------------Max speed.
		speedatmaxturn(20) ;-------------------------Max speed at max turn.
		reverse(5) ;---------------------------------Max speed in Reverse.
		weight(0.075) ;------------------------------Weight in Tonnes.
		power(1.3) ;---------------------------------Horse Power.
		fuel(0.1) ;----------------------------------Fuel capacity in Litres.
		type(fuel) ;---------------------------------Fuel type.
		range(1000) ;--------------------------------Range in Kilometers.
	)
}

(define "bike_parts"
	{volume %0
		{thickness %1}
		{able {visible 0}}
	}
)

(define "bike_thickness"
	("bike_parts" args "body1" %thickness)
	("bike_parts" args "body2" %thickness)
	("bike_parts" args "body3" %thickness)
	("bike_parts" args "body4" %thickness)
	("bike_parts" args "body5" %thickness)
	("bike_parts" args "body6" %thickness)
	("bike_parts" args "body7" %thickness)
	("bike_parts" args "body8" %thickness)
	("bike_parts" args "body9" %thickness)
	("bike_parts" args "body10" %thickness)
	("bike_parts" args "wheelleft1" 0.5)
	("bike_parts" args "wheelleft2" 0.5)
)

("body" repair(30))
("bike_thickness" thickness(1))
("bike_durability" body(100))

{perks {blastwave_modifier 9.0}}
